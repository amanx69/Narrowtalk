# ── Environment / Django Settings ────────────────────────────────────────────
DEBUG=False
SECRET_KEY=your-secret-key-here
ALLOWED_HOSTS=localhost,127.0.0.1,api.yourdomain.com
ENVIRONMENT=production
CSRF_TRUSTED_ORIGINS=https://api.yourdomain.com,http://127.0.0.1:8000,http://localhost:8000

# ── Database Configuration (PostgreSQL) ──────────────────────────────────────
name=your_db_name
username=your_db_user
password=your_db_password
host=localhost
port=5432
DB_CONN_MAX_AGE=60

# ── Redis & Celery ───────────────────────────────────────────────────────────
REDIS_URL=redis://127.0.0.1:6379/1
Redis_caches=//127.0.0.1:6379/2
CELERY_BROKER_URL=redis://127.0.0.1:6379/0

# ── Email (SMTP / Transactional Email Provider) ──────────────────────────────
email_b=django.core.mail.backends.smtp.EmailBackend
email_h=smtp.gmail.com
email_port=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_TIMEOUT=10
email_host=your_email@gmail.com
email_pass=your_email_app_password
DEFAULT_FROM_EMAIL=noreply@yourdomain.com
SERVER_EMAIL=noreply@yourdomain.com

# ── Cloudinary Media Storage ─────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ── Google OAuth ─────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your-web-client-id.apps.googleusercontent.com

# ── Sentry Error Monitoring & APM (Optional) ─────────────────────────────────
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.2

# ── Base URLs ────────────────────────────────────────────────────────────────
BASE_URL=https://api.yourdomain.com
backend_url=https://api.yourdomain.com

backend_url=https://api.yourdomain.com
BASE_URL=https://api.yourdomain.com